<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } %>

        <section class="edit-reservation-form-container">
            <form class="edit-reservation-form" action="/appointment/edit" method="post">

                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="account_firstname" required
                    value="<%= locals.account_firstname %>" disabled>

                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="account_lastname" required value="<%= locals.account_lastname %>"
                    disabled>

                <label for="email">Email:</label>
                <input type="email" id="email" name="account_email" required value="<%= locals.account_email %>"
                    placeholder="Enter a valid email address" disabled>

                <p>Fecha acltual: <%= locals.dateString %>
                </p>
                <label for="date">Fechas y horarios diponibles</label>
                <%- grid %>


                    <input type="number" name="reservation_id" value="<%= locals.reservation_id %>" hidden>

                    <% if(locals.type==="Admin" ){ %>

                        <p>Servicio actual: <%= locals.currentService %>
                        </p>
                        <select name="serviceReservations" id="serviceReservations">
                            <%- selectList %>
                        </select>
                        <% } %>
                            <% if((locals.type==="Client" && locals.currentService===undefined ) ||
                                locals.type==="Admin" ) {%>
                                <button type="submit">Editar </button>
                                <% }else{ %>
                                    <p>El servicio y el precio ya han sido ingresado, no se puede editar</p>
                                    <%}%>
            </form>
        </section>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>