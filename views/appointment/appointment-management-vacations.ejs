<% if (title) { %>
    <h1>
        <%= title %>
    </h1>

    <% } %>

        <section class="management-vacations schedule-not-available">
            <h2>Vacaciones</h2>
            <form class="management-vacations-form" action="/appointment/managementVacations" method="post">


                <label for="start-day">Elige el día que comienza sus vacaciones</label>
                <input type="date" id="start-day" name="startDay">

                <label for="end-day">Elige el día que finaliza sus vacaciones</label>
                <input type="date" id="end-day" name="endDay">

                <button type="submit">Ingresa tus vacaciones</button>

            </form>

            <h2>Eliminar horas específicas</h2>
            <form class="schedule-not-available-Form" action="/appointment/schedule-not-available" method="post">


                <label for="not_available">Elige el día</label>
                <input type="date" id="not_available" name="not_available">

                <label for="end-day">Eliminar las siguientes horas de la agends</label>
                <div id="radioElement">
                    <!-- Radio elements here, a lot -->
                </div>


                <button type="submit">Elimina las horas seleccionadas</button>
            </form>

            <h3 class="h3-vacations">Listado de vacaciones registradas hasta el momento</h3>
            <table class="vacations">
                <thead>
                    <tr>
                        <th>Fecha de comienzo</th>
                        <th>Fecha de finalización</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(const date of vacations){%>
                        <tr>
                            <td>
                                <%= date.datestart.toLocaleString("es-UY", { weekday: "short" , day: "2-digit" ,
                                    month: "2-digit" , year: "numeric" }); %>
                            </td>
                            <td>
                                <% const d=new Date(date.dateend.getTime() - 24 * 60 * 60 * 1000); %>
                                    <%= d.toLocaleString("es-UY", { weekday: "short" , day: "2-digit" , month: "2-digit"
                                        , year: "numeric" }); %>
                            </td>
                            <td>
                                <button type="button" class="btn-delete" data-id="<%= date.vacation_id %>">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                        <% } %>
                </tbody>
            </table>

            <h3 class="h3-disableHours">Fechas especificas desabilitadas</h3>
            <ul class="disabledHoursList">
                <% for(const date of dates){ %>
                    <li>
                        <%= date.time_disabled.toLocaleString("es-UY", { weekday: "short" , day: "2-digit" ,
                            month: "2-digit" , year: "numeric" , hour:"numeric", minute:"numeric" }) %>
                            <button type="button" class="delete-disabledHours"
                                data-id="<%= date.disablehours_id %>">Eliminar</button>
                    </li>
                    <% } %>
            </ul>

        </section>


        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>


                    <dialog id="confirmDeleteDialog">
                        <form method="dialog">
                            <p>¿Seguro que querés eliminar estas vacaciones?</p>

                            <menu>
                                <button value="cancel">Cancelar</button>
                                <button id="confirmDeleteBtn" value="confirm">Eliminar</button>
                            </menu>
                        </form>
                    </dialog>

                    <script src="../../js/scheduleNotAvailableForm.js"></script>
                    <script>
                        const dialog = document.getElementById("confirmDeleteDialog");
                        const confirmBtn = document.getElementById("confirmDeleteBtn");

                        let vacationidToDelete = null;
                        let disabledhoursDelete = null;

                        document.addEventListener("click", (e) => {
                            const btn = e.target.closest(".btn-delete");
                            const btnDisabledHours = e.target.closest(".delete-disabledHours")
                            if (!btn && !btnDisabledHours) return;
                            vacationidToDelete = null;
                            disabledhoursDelete = null;


                            if (btn) {
                                vacationidToDelete = btn.dataset.id;
                            }
                            else {
                                disabledhoursDelete = btnDisabledHours.dataset.id;
                            }
                            console.log(vacationidToDelete, disabledhoursDelete)
                            dialog.showModal();
                        });

                        confirmBtn.addEventListener("click", () => {
                            if (!vacationidToDelete && !disabledhoursDelete) return;
                            if (vacationidToDelete) { window.location.href = `deletevacation/${vacationidToDelete}`; return; }
                            if (disabledhoursDelete) { window.location.href = `deletedisabledhours/${disabledhoursDelete}`; return; }
                        });
                    </script>