<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } %>

        <section class="delete-reservation-form-container">
            <form class="delete-reservation-form" action="/appointment/delete" method="post">

                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="account_firstname" required
                    value="<%= locals.account_firstname %>" disabled>

                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="account_lastname" required value="<%= locals.account_lastname %>"
                    disabled>

                <label for="email">Email:</label>
                <input type="email" id="email" name="account_email" required value="<%= locals.account_email %>"
                    placeholder="Enter a valid email address" disabled>


                <label for="date">Fecha y hora</label>
                <input type="text" name="date" id="date" value="<%= locals.appointment_datetime %>" disabled>

                <label for="service_name">Nombre del servicio</label>
                <input type="text" name="service_name" id="service_name" value="<%= locals.service_name %>" disabled>

                <label for="service_description">Descripción del servicio</label>
                <input type="text" name="service_descriptione" id="service_description"
                    value="<%= locals.service_description %>" disabled>

                <label for="service_price">Precio del servicio</label>
                <input type="number" name="service_price" id="service_price" value="<%= locals.service_price %>"
                    disabled>


                <label for="service_created_at">Fecha de creación</label>
                <input type="text" name="service_created_at" id="service_created_at" value="<%= locals.created_at %>"
                    disabled>


                <input type="number" name="reservation_id" value="<%= locals.reservation_id %>" hidden>

                <button type="submit">Confirmar </button>
            </form>
        </section>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>