<% if (title) { %>
    <h1>
        <%= title %>
    </h1>

    <% } %>


        <section class="management-appointments">
            <h2>Agenda</h2>
            <div class="filters">
                <label for="filterByemail">Filtrar por email: <input type="text" name="filterByemail" id="filterByemail"
                        placeholder="email@email.com"></label>

                <label for="filterBydate">Filtrar por fecha: <input type="date" id="filterBydate"
                        name="filterBydate"></label>
            </div>

            <div id="management-appointments">

            </div>
        </section>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <script src="../../js/scheduleNotAvailableForm.js"></script>
                    <script src="../../js/managementReservations.js"></script>